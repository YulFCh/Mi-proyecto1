                            <input type="text"
                                   id="modelo"
                                   class="form-control" />
                        </div>
                    </div>

                    <!-- Código y Descripción corta -->
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="codigoProducto">Código Producto</label>
                            <input type="text"
                                   id="codigoProducto"
                                   class="form-control" />
                        </div>

                        <div class="col-md-8 mb-3">
                            <label for="descripcion">Descripción corta</label>
                            <textarea id="descripcion"
                                      class="form-control"
                                      rows="1"></textarea>
                        </div>
                    </div>

                    <!-- Descripción detallada -->
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label for="descripcion1">Descripción detallada</label>
                            <textarea id="descripcion1"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Ingrese especificaciones o párrafos largos..."></textarea>
                        </div>
                    </div>

                    <!-- Garantía y Estado -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="garantia">Garantía</label>
                            <select id="garantia" class="form-control">
                                <option value="">Seleccione garantía...</option>
                                <option value="3 Meses">3 Meses</option>
                                <option value="6 Meses">6 Meses</option>
                                <option value="12 Meses">12 Meses</option>
                                <option value="24 Meses">24 Meses</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="estado">Estado</label>
                            <select id="estado" class="form-control">
                                <option value="">Seleccione</option>
                                <option value="ACTIVO">ACTIVO</option>
                                <option value="INACTIVO">INACTIVO</option>
                                <option value="AGOTADO">AGOTADO</option>
                            </select>
                        </div>
                    </div>

                    <!-- Precios -->
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="precio">Precio actual</label>
                            <input type="number"
                                   id="precio"
                                   step="0.01"
                                   class="form-control" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label for="precioAntes">Precio anterior</label>
                            <input type="number"
                                   id="precioAntes"
                                   step="0.01"
                                   class="form-control" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label for="descuento">Descuento</label>
                            <input type="number"
                                   id="descuento"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="20" />
                        </div>
                    </div>

                    <!-- Imágenes -->
                    <div class="mb-3">
                        <label for="fileImage">Imágenes del equipo (máx. 4)</label>
                        <input type="file"
                               id="fileImage"
                               accept="image/*"
                               multiple
                               class="form-control" />
                    </div>

                    <!-- Vista previa -->
                    <div id="previewContainer"
                         style="display:flex; gap:10px; flex-wrap:wrap; margin-top:10px;">
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary w-100"
                            onclick="guardarEquipo()">
                        Guardar Equipo
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>





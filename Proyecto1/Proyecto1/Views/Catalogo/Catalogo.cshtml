                                      placeholder="Ingrese especificaciones o párrafos largos..."></textarea>
                        </div>
                    </div>

                    <!-- Garantía y Estado -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="garantia">Garantía</label>
                            <select id="garantia" class="form-control">



@{
    ViewData["Title"] = "Todos los productos";

    var estaLogueado = User.Identity.IsAuthenticated;

    Layout = estaLogueado
        ? "~/Views/Shared/_LayoutNavegador.cshtml"
        : "~/Views/Shared/_LayoutInicio.cshtml";
}

<div id="configVista" data-vista="catalogos" hidden></div>

<head>



</head>

@if (User.Identity.IsAuthenticated)
{
    <button type="button"
            class="btn btn-success"
            data-toggle="modal"
            data-target="#modalAgregar">
        Agregar Foto
    </button>

    <div class="control-precios">
        <span>Mostrar precios</span>

        <label class="switch-precios">
            <input type="checkbox"
                   id="switchPreciosGeneral"
                   checked
                   onchange="alternarVisibilidadPreciosGeneral(this)">
            <span class="slider-precios"></span>
        </label>
    </div>
}

<nav id="breadcrumbCategorias"
     class="breadcrumb-categorias"
     aria-label="Ruta de navegación">
</nav>

<!-- CONTENEDOR GENERAL: FILTROS + PRODUCTOS -->
<div class="catalogo-layout">
    @if (!estaLogueado)
    {
        <!-- PANEL LATERAL DE FILTROS -->
        <!-- BOTÓN FILTROS PARA CELULAR -->
        <button type="button"
                id="btnMostrarFiltrosMovil"
                class="btn-filtros-movil"
                aria-expanded="false"
                aria-controls="panelFiltros"
                onclick="
                const panel = document.getElementById('panelFiltros');
                const abierto = panel.classList.toggle('filtros-movil-abiertos');
                this.setAttribute('aria-expanded', abierto);
                this.innerHTML = abierto
                    ? '✕ &nbsp; Ocultar filtros'
                    : '☰ &nbsp; Mostrar filtros';
            ">
            ☰ &nbsp; Mostrar filtros
        </button>

        <aside class="panel-filtros" id="panelFiltros"
        style="
        box-sizing:border-box;
        width:100%;
        min-width:0;
        padding:10px;
        border:1px solid #e4e4e7;
        border-radius:14px;
        background:#f3f4f6;
        overflow:hidden;
        ">

        <!-- ENCABEZADO -->
        <div class="filtros-header"
             style="
             display:flex;
             align-items:center;
             justify-content:space-between;
             gap:8px;
             width:100%;
             min-width:0;
             box-sizing:border-box;
             padding:0 0 15px;
             margin:0 0 20px;
             border-bottom:1px solid #f1d5e5;
         ">

            <!-- TÍTULO FILTROS -->
            <h4 style="
            display:flex;
            align-items:center;
            gap:9px;
            min-width:0;
            margin:0;
            color:#27272a;
            font-size:16px;
            font-weight:750;
            letter-spacing:.3px;
        ">

                <span style="
                display:inline-flex;
                align-items:center;
                justify-content:center;
                flex-shrink:0;
                width:35px;
                height:35px;
                border-radius:10px;
                background:#fce7f3;
                color:#ff0094;
            ">
                    <svg width="19" height="19"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M4 7h9" />
                        <path d="M17 7h3" />
                        <path d="M4 17h3" />
                        <path d="M11 17h9" />
                        <circle cx="15" cy="7" r="2" />
                        <circle cx="9" cy="17" r="2" />
                    </svg>
                </span>

                FILTROS
            </h4>

            <!-- BOTÓN LIMPIAR -->
            <button type="button"
                    id="limpiarFiltros"
                    class="btn-limpiar-filtros"
                    style="
                    display:inline-flex;
                    align-items:center;
                    justify-content:center;
                    gap:5px;
                    flex:0 0 auto;
                    box-sizing:border-box;
                    max-width:100%;
                    min-width:0;
                    padding:7px 9px;
                    margin:0;
                    border:1px solid #f0b8d8;
                    border-radius:8px;
                    background:#fff;
                    color:#ff0094;
                    font-family:inherit;
                    font-size:11px;
                    font-weight:600;
                    line-height:1.2;
                    white-space:nowrap;
                    cursor:pointer;
                    transition:background .2s,border-color .2s;
                ">

                <svg width="14" height="14"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
                    <path d="M3 3v5h5" />
                </svg>

                Limpiar
            </button>
        </div>


        <!-- MARCA -->
        <section class="filtro-seccion"
                 style="
                 box-sizing:border-box;
                 width:100%;
                 min-width:0;
                 margin:0 0 22px;
             ">

            <h5 style="
            display:flex;
            align-items:center;
            gap:8px;
            margin:0 0 12px;
            color:#27272a;
            font-size:12px;
            font-weight:750;
            letter-spacing:1px;
            text-transform:uppercase;
        ">

                <svg width="17" height="17"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="#ff0094"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z" />
                    <circle cx="7.5" cy="7.5" r="1" />
                </svg>

                MARCA
            </h5>

            <!-- BUSCADOR DE MARCA -->
            <div class="filtro-busqueda"
                 style="
                 display:flex;
                 align-items:center;
                 gap:10px;
                 box-sizing:border-box;
                 width:100%;
                 min-width:0;
                 min-height:42px;
                 padding:0 12px;
                 border:1px solid #e4e4e7;
                 border-radius:10px;
                 background:#fff;
                 transition:border-color .2s,background .2s;
             ">

                <svg viewBox="0 0 24 24"
                     width="18"
                     height="18"
                     fill="none"
                     stroke="#71717a"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true"
                     style="flex-shrink:0;">
                    <circle cx="10.5" cy="10.5" r="6.5" />
                    <path d="m16 16 5 5" />
                </svg>

                <input type="search"
                       id="filtroMarca"
                       placeholder="Buscar marca..."
                       autocomplete="off"
                       style="
                       display:block;
                       flex:1;
                       width:100%;
                       min-width:0;
                       box-sizing:border-box;
                       padding:10px 0;
                       margin:0;
                       border:none;
                       outline:none;
                       box-shadow:none;
                       background:transparent;
                       color:#27272a;
                       font-family:inherit;
                       font-size:13px;
                   ">
            </div>
        </section>


        <!-- PRECIO -->
        <section class="filtro-seccion"
                 style="
                 box-sizing:border-box;
                 width:100%;
                 min-width:0;
                 margin:0 0 22px;
             ">

            <h5 style="
            display:flex;
            align-items:center;
            gap:8px;
            margin:0 0 12px;
            color:#27272a;
            font-size:12px;
            font-weight:750;
            letter-spacing:1px;
            text-transform:uppercase;
        ">

                <svg width="17" height="17"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="#ff0094"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="3" />
                    <path d="M3 10h18" />
                    <path d="M7 15h3" />
                </svg>

                PRECIO
            </h5>

            <!-- MENOS DE S/ 1000 -->
            <label class="filtro-opcion"
                   style="
                   display:flex;
                   align-items:center;
                   gap:10px;
                   box-sizing:border-box;
                   width:100%;
                   min-width:0;
                   padding:11px 12px;
                   margin:0 0 7px;
                   border:1px solid #f0d7e6;
                   border-radius:10px;
                   background:#fff;
                   color:#3f3f46;
                   font-size:13px;
                   cursor:pointer;
                   transition:border-color .2s,background .2s;
               ">

                <input type="checkbox"
                       name="filtroPrecio"
                       value="menos1000"
                       style="
                       flex-shrink:0;
                       accent-color:#ff0094;
                       cursor:pointer;
                   ">

                <span>Menos de S/ 1000</span>
            </label>

            <!-- ENTRE S/ 1000 Y S/ 5000 -->
            <label class="filtro-opcion"
                   style="
                   display:flex;
                   align-items:center;
                   gap:10px;
                   box-sizing:border-box;
                   width:100%;
                   min-width:0;
                   padding:11px 12px;
                   margin:0 0 7px;
                   border:1px solid #f0d7e6;
                   border-radius:10px;
                   background:#fff;
                   color:#3f3f46;
                   font-size:13px;
                   cursor:pointer;
                   transition:border-color .2s,background .2s;
               ">

                <input type="checkbox"
                       name="filtroPrecio"
                       value="1000a5000"
                       style="
                       flex-shrink:0;
                       accent-color:#ff0094;
                       cursor:pointer;
                   ">

                <span>S/ 1000 - S/ 5000</span>
            </label>

            <!-- MÁS DE S/ 5000 -->
            <label class="filtro-opcion"
                   style="
                   display:flex;
                   align-items:center;
                   gap:10px;
                   box-sizing:border-box;
                   width:100%;
                   min-width:0;
                   padding:11px 12px;
                   margin:0 0 7px;
                   border:1px solid #f0d7e6;
                   border-radius:10px;
                   background:#fff;
                   color:#3f3f46;
                   font-size:13px;
                   cursor:pointer;
                   transition:border-color .2s,background .2s;
               ">

                <input type="checkbox"
                       name="filtroPrecio"
                       value="mas5000"
                       style="
                       flex-shrink:0;
                       accent-color:#ff0094;
                       cursor:pointer;
                   ">

                <span>Más de S/ 5000</span>
            </label>

        </section>


        <!-- BOTÓN APLICAR FILTROS -->
        <button type="button"
                id="btnAplicarFiltros"
                class="btn-aplicar-filtros"
                style="
                display:flex;
                align-items:center;
                justify-content:center;
                gap:9px;
                box-sizing:border-box;
                width:100%;
                min-width:0;
                padding:13px 16px;
                margin:0;


border: 1px solid #ff0094;
background: #f3f4f6;
color: #ff0094;
                font-family:inherit;
                font-size:12px;
                font-weight:700;
                letter-spacing:.3px;
                cursor:pointer;
                transition:background .2s,box-shadow .2s;
            ">

            FILTRAR PRODUCTOS
        </button>


        <!-- MENSAJE DE FILTROS -->
        <p id="mensajeFiltros"
           class="mensaje-filtros"
           aria-live="polite"></p>

    </aside>
    }

    <!-- PRODUCTOS: SE CONSERVA EL ID QUE USA TU JAVASCRIPT -->
    <div class="products-container" id="contenedorProductos">

        <div id="loaderProductos" class="loader-productos">
            <div class="spinner-productos"></div>
            <span>Cargando productos...</span>
        </div>

    </div>

</div>



<div class="modal fade" id="modalZoom" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="zoom-titulo-producto">
                    Detalle del Producto
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">

                    <!-- COLUMNA IZQUIERDA: IMAGEN Y MINIATURAS -->
                    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center zoom-stage-col">
                        <div class="zoom-main-frame">
                            <button type="button" id="zoom-prev-btn" class="zoom-nav-btn zoom-nav-prev" onclick="navegarImagenZoom(-1)" aria-label="Imagen anterior">
                                <span class="zoom-chevron" aria-hidden="true"></span>
                            </button>

                            <img id="zoom-imagen-principal" src="" alt="Vista previa del producto" />

                            <button type="button" id="zoom-next-btn" class="zoom-nav-btn zoom-nav-next" onclick="navegarImagenZoom(1)" aria-label="Siguiente imagen">
                                <span class="zoom-chevron" aria-hidden="true"></span>
                            </button>
                        </div>

                        <div id="zoom-galeria-miniaturas"></div>
                    </div>

                    <!-- COLUMNA DERECHA: DETALLES Y COMPRA -->
                    <div class="col-md-6 d-flex flex-column justify-content-between zoom-details-col">
                        <div>
                            <span id="zoom-tipo-badge" class="zoom-type-badge">TIPO</span>

                            <h4 id="zoom-marca">MARCA</h4>
                            <p id="zoom-modelo-desc">Modelo y descripción detallada del equipo.</p>

                            <div class="zoom-code-row">
                                <span>Código de producto: </span>
                                <strong id="zoom-codigo">N/A</strong>
                            </div>

                            <a href="javascript:void(0)"
                               id="zoom-btn-caracteristicas"
                               class="zoom-specs-link">
                                <span>&#9783; Más características</span>
                                <span aria-hidden="true">&#9662;</span>
                            </a>

                            <div id="zoom-color-container" class="zoom-color-section">
                                <span class="zoom-section-label">Color disponible</span>
                                <div id="zoom-lista-colores">
                                    <button type="button" class="color-circle active" style="background-color: #7A1F87;" aria-label="Color principal"></button>
                                    <button type="button" class="color-circle" style="background-color: #DC2626;" aria-label="Rojo"></button>
                                    <button type="button" class="color-circle" style="background-color: #FFFFFF;" aria-label="Blanco"></button>
                                </div>
                            </div>

                            <div id="zoom-precios-container" class="zoom-price-box">
                                <div class="zoom-price-main">
                                    <span id="zoom-precio-actual"></span>
                                    <span id="zoom-descuento-badge" style="display: none;">-0%</span>
                                </div>

                                <div id="zoom-precio-antes-container" style="display: none;">
                                    <span>Antes: </span>
                                    <span id="zoom-precio-antes"></span>
                                </div>
                            </div>
                        </div>

                        <div>
                            <div id="zoom-acciones-compra" class="zoom-purchase-bar">
                                <div class="zoom-qty-control">
                                    <button type="button" class="zoom-qty-btn" onclick="cambiarCantidadZoom(-1)" aria-label="Disminuir cantidad">-</button>
                                    <span id="cant-display-zoom">1</span>
                                    <button type="button" class="zoom-qty-btn" onclick="cambiarCantidadZoom(1)" aria-label="Aumentar cantidad">+</button>
                                </div>

                                <button type="button" class="btn btn-agregar-carrito" id="zoom-btn-agregar">
                                    Agregar al carrito
                                </button>
                            </div>

                            <div class="zoom-perks-grid">
                                <div id="zoom-garantia-container" class="zoom-perk-card">
                                    <span class="zoom-perk-icon" aria-hidden="true">🛡️</span>
                                    <strong class="zoom-perk-title">Garantía</strong>
                                    <span id="zoom-garantia" class="zoom-perk-sub">12 Meses</span>
                                </div>
                                <div class="zoom-perk-card">
                                    <span class="zoom-perk-icon" aria-hidden="true">💳</span>
                                    <strong class="zoom-perk-title">Pagos</strong>
                                    <span class="zoom-perk-sub">Efectivo / Tarjeta</span>
                                </div>
                                <div class="zoom-perk-card">
                                    <span class="zoom-perk-icon" aria-hidden="true">🚚</span>
                                    <strong class="zoom-perk-title">Envíos</strong>
                                    <span class="zoom-perk-sub">Todo el Perú</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ESPECIFICACIONES DESPLEGABLES -->
                <div class="collapse zoom-specs-panel" id="zoom-caracteristicas-collapse">
                    <div class="zoom-specs-box">
                        <strong class="zoom-specs-eyebrow">Información de este producto</strong>
                        <div id="zoom-caracteristicas-titulo"></div>
                        <div id="zoom-caracteristicas-texto">Cargando especificaciones adicionales...</div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- VISOR DE IMAGEN GRANDE -->
<!-- VISOR DE IMAGEN GRANDE -->
<div id="visorImagenGrande" class="visor-imagen-grande">

    <!-- BOTÓN CERRAR -->
    <button type="button"
            id="cerrarImagenGrande"
            class="visor-cerrar"
            aria-label="Cerrar">
        &times;
    </button>


    <!-- FLECHA ANTERIOR -->
    <button type="button"
            id="visorImagenAnterior"
            class="visor-flecha visor-flecha-izquierda"
            aria-label="Imagen anterior">
        &#10094;
    </button>


    <!-- IMAGEN -->
    <img id="imagenGrandeZoom"
         src=""
         alt="Imagen del producto">


    <!-- FLECHA SIGUIENTE -->
    <button type="button"
            id="visorImagenSiguiente"
            class="visor-flecha visor-flecha-derecha"
            aria-label="Imagen siguiente">
        &#10095;
    </button>

</div>

<div id="toastMensaje"
     style="
        position: fixed;
        top: 20px;
        right: 20px;
        background: #d7007c;
        color: white;
        padding: 12px 18px;
        border-radius: 6px;
        display: none;
        z-index: 9999;
        font-weight: 500;
     ">
    Guardado correctamente
</div>

<div class="modal fade" id="modalCheckout" tabindex="-1" role="dialog" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">

        <div class="modal-content checkout-modal-content">

            <!-- ========================================= -->
            <!-- HEADER -->
            <!-- ========================================= -->


            <div class="modal-header border-0 checkout-header">

                <div class="checkout-header-content">


                    <div class="checkout-header-icon">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="21"
                             height="21"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="M3 6h12v12H3z" />
                            <path d="M15 10h4l3 4v4h-7z" />
                            <circle cx="7.5" cy="18" r="2" />
                            <circle cx="18.5" cy="18" r="2" />
                            <path d="M15 14h7" />
                        </svg>
                    </div>

                    <div class="checkout-header-text">
                        <h5 class="modal-title">
                            Datos de Envío y Facturación
                        </h5>

                        <p>Completa tus datos para coordinar la entrega</p>
                    </div>

                </div>

                <button type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Cerrar">

                    <span>&times;</span>

                </button>

            </div>


            <!-- ========================================= -->
            <!-- FORMULARIO -->
            <!-- ========================================= -->

            <form id="formCheckout"
                  onsubmit="procesarCompra(event)"
                  class="checkout-form">

                <!-- ===================================== -->
                <!-- CONTENIDO -->
                <!-- ===================================== -->

                <div class="modal-body checkout-body">


                    <!-- ================================ -->
                    <!-- DATOS PERSONALES -->
                    <!-- ================================ -->

                    <div class="row">

                        <div class="form-group col-md-6">

                            <label style="font-weight: 600; font-size: 13px;">
                                Nombres
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="chkNombres"
                                   class="form-control"
                                   required
                                   style="border-radius: 6px;">

                        </div>


                        <div class="form-group col-md-6">

                            <label style="font-weight: 600; font-size: 13px;">
                                Apellidos
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="chkApellidos"
                                   class="form-control"
                                   required
                                   style="border-radius: 6px;">

                        </div>

                    </div>


                    <!-- ================================ -->
                    <!-- DNI / CELULAR -->
                    <!-- ================================ -->

                    <div class="row">

                        <div class="form-group col-md-6">

                            <label style="font-weight: 600; font-size: 13px;">
                                DNI
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="chkDni"
                                   class="form-control"
                                   required
                                   maxlength="12"
                                   style="border-radius: 6px;">

                        </div>


                        <div class="form-group col-md-6">

                            <label style="font-weight: 600; font-size: 13px;">
                                Número de Celular
                                <span class="text-danger">*</span>
                            </label>

                            <input type="tel"
                                   id="chkCelular"
                                   class="form-control"
                                   required
                                   style="border-radius: 6px;">

                        </div>

                    </div>


                    <!-- ================================ -->
                    <!-- CORREO -->
                    <!-- ================================ -->

                    <div class="row">

                        <div class="form-group col-12">

                            <label style="font-weight: 600; font-size: 13px;">
                                Correo Electrónico
                                <span class="text-danger">*</span>
                            </label>

                            <input type="email"
                                   id="chkCorreo"
                                   class="form-control"
                                   required
                                   style="border-radius: 6px;">

                        </div>

                    </div>


                    <hr style="border-style: dashed; margin: 15px 0;">


                    <!-- ================================ -->
                    <!-- DIRECCIÓN -->
                    <!-- ================================ -->

                    <h6 style="
                        font-weight: bold;
                        margin-bottom: 15px;
                        font-size: 14px;
                        color: #555;
                    ">
                        Dirección de Entrega
                    </h6>


                    <div class="row">

                        <!-- REGIÓN -->

                        <div class="form-group col-md-4">

                            <label style="font-weight: 600; font-size: 13px;">
                                Región
                                <span class="text-danger">*</span>
                            </label>

                            <select id="chkRegion"
                                    class="form-control"
                                    required
                                    style="border-radius: 6px;">

                                <option value="">
                                    Seleccione...
                                </option>

                            </select>

                        </div>


                        <!-- PROVINCIA -->

                        <div class="form-group col-md-4">

                            <label style="font-weight: 600; font-size: 13px;">
                                Provincia
                                <span class="text-danger">*</span>
                            </label>

                            <select id="chkProvincia"
                                    class="form-control"
                                    required
                                    disabled
                                    style="border-radius: 6px;">

                                <option value="">
                                    Seleccione...
                                </option>

                            </select>

                        </div>


                        <!-- DISTRITO -->

                        <div class="form-group col-md-4">

                            <label style="font-weight: 600; font-size: 13px;">
                                Distrito
                                <span class="text-danger">*</span>
                            </label>

                            <select id="chkDistrito"
                                    class="form-control"
                                    required
                                    disabled
                                    style="border-radius: 6px;">

                                <option value="">
                                    Seleccione...
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- ================================ -->
                    <!-- DIRECCIÓN -->
                    <!-- ================================ -->

                    <div class="row">

                        <div class="form-group col-12">

                            <label style="font-weight: 600; font-size: 13px;">
                                Dirección de Domicilio
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="chkDireccion"
                                   class="form-control"
                                   placeholder="Av. Principal 123 - Dpto 401"
                                   required
                                   style="border-radius: 6px;">

                        </div>

                    </div>

                    <!-- ================================ -->
                    <!-- NOTA DEL CLIENTE -->
                    <!-- ================================ -->

                    <div class="row">

                        <div class="form-group col-12">

                            <label style="font-weight: 600; font-size: 13px;">
                                Nota del cliente
                                <span class="text-muted">(Opcional)</span>
                            </label>

                            <textarea id="chkNotaCliente"
                                      class="form-control"
                                      rows="2"
                                      maxlength="500"
                                      style="border-radius: 6px; resize: vertical;"></textarea>

                        </div>

                    </div>




                    <!-- ================================ -->
                    <!-- TOTAL -->
                    <!-- ================================ -->

                    <div class="checkout-total">

                        <span>
                            Monto Final a Pagar:
                        </span>

                        <strong id="chkMontoFinal">
                            S/. 0.00
                        </strong>

                    </div>

                </div>


                <!-- ===================================== -->
                <!-- FOOTER -->
                <!-- ===================================== -->

                <div class="modal-footer border-0 checkout-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal"
                            style="border-radius: 6px;">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn btn-success"
                            style="
                                border-radius: 6px;
                                font-weight: bold;
                                padding-left: 25px;
                                padding-right: 25px;
                            ">

                        Finalizar Pedido

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<div class="modal fade"

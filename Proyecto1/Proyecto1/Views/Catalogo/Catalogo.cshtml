                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary w-100"
                            onclick="guardarEquipo()">
                        Guardar Equipo
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>





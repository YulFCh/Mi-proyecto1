@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? "FRACTÁLICA")</title>

    <link rel="stylesheet" href="~/assets/css/style.css" />
    <link rel="stylesheet" href="~/css/styleModal.css" />

</head>

<body>

    <header class="modern-header">

        <div style="display:flex;justify-content:space-between;align-items:center;">

            <h2 style="margin:0;">fractálica</h2>

            <div style="display: flex; align-items: center; gap: 16px;">

                <button class="btn" style="background: none; border: none; padding: 4px; cursor: pointer; color: inherit;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l1.313 7h8.17l1.313-7zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
                    </svg>
                </button>

                <button class="btn modern-login-btn"
                        data-toggle="modal"
                        data-target="#loginModal"
                        title="Iniciar sesión"
                        style="display: flex; align-items: center; justify-content: center; padding: 6px; border-radius: 50%;">

                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z" />
                    </svg>

                </button>

            </div>

        </div>

    </header>

    <div class="container">
        @RenderBody()
    </div>

    <div class="modal fade" id="loginModal" tabindex="-1" role="dialog" aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered" role="document">

            <div class="modal-content modern-modal">

                <div class="modal-header border-0">

                    <div>
                        <h3 class="modal-title modern-title">
                            Bienvenido
                        </h3>
                    </div>

                    <button type="button"
                            class="close modern-close"
                            data-dismiss="modal"
                            aria-label="Close">

                        <span>&times;</span>

                    </button>

                </div>

                @{
                    var loginError = TempData["LoginError"] as string;
                }

                <div class="modal-body pt-0">

                    @if (!string.IsNullOrEmpty(loginError))
                    {
                        <div class="alert alert-danger modern-alert">
                            @loginError
                        </div>
                    }

                    <form asp-controller="Login"
                          asp-action="Index"
                          method="post">

                        <div class="form-group">

                            <label class="modern-label">
                                Usuario
                            </label>

                            <input type="text"
                                   class="form-control modern-input"
                                   name="Usuario"
                                   placeholder="Ingrese usuario" />

                        </div>

                        <div class="form-group">

                            <label class="modern-label">
                                Contraseña
                            </label>

                            <input type="password"
                                   class="form-control modern-input"
                                   name="Password"
                                   placeholder="Ingrese contraseña" />

                        </div>

                        <button type="submit"
                                class="btn modern-btn btn-block">

                            Iniciar sesión

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/assets/js/vendor-all.min.js"></script>
    <script src="~/assets/plugins/bootstrap/js/bootstrap.min.js"></script>

    @if (TempData["LoginError"] != null)
    {
        <script>
            $(document).ready(function () {
                $('#loginModal').modal('show');
            });
        </script>
    }

</body>

</html>
    // ORDEN = 0
    // ==========================================

    if (apartadosEspeciales.length > 0) {

        const seccionEspecial = document.createElement("section");
        seccionEspecial.className = "nosotros-especiales";

        const especialesGrid = document.createElement("div");
        especialesGrid.className = "nosotros-especiales-grid";

        apartadosEspeciales.forEach(apartado => {

            const titulo =
                apartado.titulo ?? apartado.Titulo ?? "";

            const resumen =
                apartado.resumen ?? apartado.Resumen ?? "";

            const descripcion =
                apartado.descripcion ?? apartado.Descripcion ?? "";

            // Tarjeta especial.
            const tarjetaEspecial = document.createElement("article");
            tarjetaEspecial.className = "nosotros-especial-card";

            // Título.
            const tituloEspecial = document.createElement("h3");
            tituloEspecial.className = "nosotros-especial-titulo";
            tituloEspecial.textContent = titulo;

                const icono = apartado.icono ?? apartado.Icono ?? "";

    if (icono) {
        const iconoEspecial = document.createElement("i");
        iconoEspecial.setAttribute("data-lucide", icono);
        iconoEspecial.className = "nosotros-especial-icono";
        tarjetaEspecial.appendChild(iconoEspecial);
    }

            tarjetaEspecial.appendChild(tituloEspecial);

                // ==========================================
    // RESUMEN CON ETIQUETAS EN NEGRITA
    // ==========================================

    if (resumen) {
        renderizarTextoConEtiquetas(tarjetaEspecial, resumen);
    }

    // ==========================================
    // DESCRIPCIÓN CON ETIQUETAS EN NEGRITA
    // ==========================================

    if (descripcion) {
        renderizarTextoConEtiquetas(tarjetaEspecial, descripcion);
    }

            especialesGrid.appendChild(tarjetaEspecial);

        });

        seccionEspecial.appendChild(especialesGrid);

        // Agregar siempre debajo de los apartados normales.
        contenido.appendChild(seccionEspecial);
    }


    // Generar iconos Lucide de las tarjetas normales.
    if (window.lucide) {
        window.lucide.createIcons();
    }



        } catch (error) {

            console.error("Error al cargar Nosotros:", error);

            const mensaje = document.createElement("p");
            mensaje.className = "nosotros-sin-registros";
            mensaje.textContent =
                "No se pudo cargar la información de la empresa.";

            contenido.appendChild(mensaje);

        } finally {

            cargandoNosotrosCategoria = false;
        }

        return;
    }


        // ==========================================
    // FORMATEAR TEXTO CON ETIQUETAS EN NEGRITA
    // ==========================================

    function renderizarTextoConEtiquetas(elemento, texto) {

        const lineas = String(texto || "").split(/\r?\n/);

        lineas.forEach(linea => {

            if (!linea.trim()) return;

            const parrafo = document.createElement("p");
            parrafo.className = "nosotros-especial-contenido";

            // Detectar viñeta.
            const tieneVineta = linea.trim().startsWith("•");

            if (tieneVineta) {
                linea = linea.trim().substring(1).trim();

                parrafo.style.paddingLeft = "15px";
                parrafo.style.textIndent = "-15px";

                parrafo.appendChild(
                    document.createTextNode("• ")
                );
            }

            // Buscar los dos puntos.
            const posicionDosPuntos = linea.indexOf(":");

            if (posicionDosPuntos !== -1) {

                // Texto anterior a los dos puntos en negrita.
                const etiqueta = document.createElement("strong");

                etiqueta.textContent =
                    linea.substring(0, posicionDosPuntos + 1);

                parrafo.appendChild(etiqueta);

                // Texto posterior en formato normal.
                parrafo.appendChild(
                    document.createTextNode(
                        linea.substring(posicionDosPuntos + 1)
                    )
                );

            } else {

                parrafo.appendChild(
                    document.createTextNode(linea)
                );
            }

            elemento.appendChild(parrafo);
        });
    }


        const equipos = window.productosAgrupados || [];

        const subcategorias = (categoria.subcategorias || []).filter(subcategoria => {
            return equipos.some(equipo => {

                const idSubcategoria =
                    equipo.idSubcategoria ?? equipo.IdSubcategoria;

                const estado = (equipo.estado || "").trim().toLowerCase();

                if (Number(idSubcategoria) !== Number(subcategoria.idSubcategoria)) {
                    return false;
                }

                if (estado === "inactivo") {
                    return false;
                }

                const nombreEquipo =
                    equipo.tipo_Equipo ??
                    equipo.tipoEquipo ??
                    equipo.Tipo_Equipo ??
                    equipo.tipo_equipo;

                return typeof nombreEquipo === "string" &&
                    nombreEquipo.trim() !== "";
            });
        });

        const columnas = document.createElement("div");
        columnas.className = "categorias-subcategorias-grid";

        subcategorias.forEach(function (subcategoria) {

            const columna = document.createElement("div");
            columna.className = "categoria-subcategoria-columna";

            const tituloSubcategoria = document.createElement("h4");
            tituloSubcategoria.textContent = subcategoria.nombre;
            tituloSubcategoria.style.cursor = "pointer";

            tituloSubcategoria.addEventListener("click", function () {

                seleccionarSubcategoria(
                    subcategoria.idSubcategoria,
                    categoria.idCategoria
                );

                tipoEquipoSeleccionado = null;

            });

            columna.appendChild(tituloSubcategoria);

            const equiposSubcategoria = equipos.filter(function (equipo) {

                const idSubcategoria =
                    equipo.idSubcategoria ?? equipo.IdSubcategoria;

                return Number(idSubcategoria) ===
                    Number(subcategoria.idSubcategoria);

            });

            const nombresEquipos = [
                ...new Set(
                    equiposSubcategoria
                        .map(equipo =>
                            equipo.tipo_Equipo ??
                            equipo.tipoEquipo ??
                            equipo.Tipo_Equipo ??
                            equipo.tipo_equipo
                        )
                        .filter(nombre =>
                            typeof nombre === "string" && nombre.trim() !== ""
                        )
                        .map(nombre => nombre.trim())
                )
            ];

            if (nombresEquipos.length === 0) {

                const mensaje = document.createElement("p");
                mensaje.textContent = "No hay equipos disponibles.";

                columna.appendChild(mensaje);

            } else {

                nombresEquipos.forEach(function (nombreEquipo) {

                    const enlace = document.createElement("a");

                    enlace.href = "#";
                    enlace.className = "categoria-detalle-enlace";
                    enlace.textContent = nombreEquipo;

                    enlace.addEventListener("click", function (event) {

                        event.preventDefault();

                        seleccionarTipoEquipo(
                            nombreEquipo,
                            subcategoria.idSubcategoria,
                            categoria.idCategoria
                        );

                    });

                    columna.appendChild(enlace);

                });
            }

            columnas.appendChild(columna);

        });

        contenido.appendChild(columnas);
    }




    });
</script>



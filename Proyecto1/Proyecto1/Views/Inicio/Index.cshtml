@model Proyecto1.Views.Inicio.IndexModel
@{
    ViewData["Title"] = "Inicio";

    var estaLogueado = User.Identity.IsAuthenticated;

    Layout = estaLogueado
        ? "~/Views/Shared/_LayoutNavegador.cshtml"
        : "~/Views/Shared/_LayoutInicio.cshtml";
}



<head>

    <link rel="stylesheet" href="~/css/styleInicio.css" />
    

</head>

@if (User.Identity.IsAuthenticated)
{
    <button type="button"
            class="btn btn-success"
            data-toggle="modal"
            data-target="#modalAgregar">
        Agregar Foto
    </button>
}

<div class="products-container" id="contenedorProductos">
</div>

<div class="modal fade"
     id="modalAgregar"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Nuevo Equipo
                </h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <form id="formNuevoEquipo" enctype="multipart/form-data">

                <div class="modal-body">

                    <!-- Tipo y Color -->
                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label>Tipo Equipo</label>
                            <select id="tipoEquipo" class="form-control">
                                <option value="">Seleccione un tipo</option>
                                <option value="LAPTOP">LAPTOP</option>
                                <option value="CPU">CPU</option>
                                <option value="MONITOR">MONITOR</option>
                                <option value="TABLET">TABLET</option>
                                <option value="IMPRESORA">IMPRESORA</option>
                                <option value="ANTIVIRUS">ANTIVIRUS</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Color</label>
                            <input type="text"
                                   id="color"
                                   class="form-control" />
                        </div>

                    </div>

                    <!-- Marca y Modelo -->
                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label>Marca</label>
                            <input type="text"
                                   id="marca"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Modelo</label>
                            <input type="text"
                                   id="modelo"
                                   class="form-control" />
                        </div>

                    </div>

                    <!-- Código y Descripción -->
                    <div class="row">

                        <div class="col-md-4 mb-3">
                            <label>Código Producto</label>
                            <input type="text"
                                   id="codigoProducto"
                                   class="form-control" />
                        </div>

                        <div class="col-md-8 mb-3">
                            <label>Descripción</label>
                            <textarea id="descripcion"
                                      class="form-control"
                                      rows="1"></textarea>
                        </div>

                    </div>

                    <!-- Precios -->
                    
                    <div class="row">

                        <div class="col-md-4 mb-3">
                            <label>Precio actual</label>
                            <input type="number"
                                   id="precio"
                                   step="0.01"
                                   class="form-control" readonly/>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label>Precio anterior</label>
                            <input type="number"
                                   id="precioAntes"
                                   step="0.01"
                                   class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label>Descuento</label>
                            <input type="number"
                                   id="descuento"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="20" />
                        </div>
                   

                    </div>

                    <!-- Estado -->
                    <div class="row">

                        <div class="col-12 mb-3">
                            <label>Estado</label>
                            <select id="estado" class="form-control">
                                <option value="">Seleccione</option>
                                <option value="ACTIVO">ACTIVO</option>
                                <option value="INACTIVO">INACTIVO</option>
                                <option value="AGOTADO">AGOTADO</option>
                            </select>
                        </div>

                    </div>

                    <!-- Imágenes -->
                    <div class="mb-3">
                        <label>Imágenes del equipo (máx 4)</label>
                        <input type="file"
                               id="fileImage"
                               accept="image/*"
                               multiple
                               class="form-control" />
                    </div>

                    <!-- Preview -->
                    <div id="previewContainer"
                         style="display:flex; gap:10px; flex-wrap:wrap; margin-top:10px;">
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary w-100"
                            onclick="guardarEquipo()">
                        Guardar Equipo
                    </button>
                </div>

            </form>



        </div>
    </div>

</div>



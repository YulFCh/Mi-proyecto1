@model Proyecto1.Views.Inicio.IndexModel
@{
    ViewData["Title"] = "Inicio";

    var estaLogueado = User.Identity.IsAuthenticated;

    Layout = estaLogueado
        ? "~/Views/Shared/_LayoutNavegador.cshtml"
        : "~/Views/Shared/_LayoutInicio.cshtml";
}



<head>

    <link rel="stylesheet" href="~/css/styleInicio.css" />

    <link rel="stylesheet" href="~/css/carrusel.css" />    

</head>


@if (User.Identity?.IsAuthenticated == true)
{
    <div style="display:flex; justify-content:flex-start;
                    padding:0 20px; margin:10px 0;">

        <button type="button"
                class="btn btn-success"
                data-toggle="modal"
                data-target="#modalAgregarPromociones">
            <i class="feather icon-image"></i>
            Agregar promociones
        </button>

    </div>
}


@if (User.Identity?.IsAuthenticated == true)
{
    <div style="padding: 10px 20px;">
        <button type="button"
                class="btn btn-primary"
                onclick="cargarListaPromociones()">
            <i class="feather icon-edit"></i>
            Administrar promociones
        </button>
    </div>

    <div id="listaAdministrarPromociones"
         style="display:none; padding:20px;">

        <h5>Promociones registradas</h5>

        <div id="tablaPromociones"></div>
    </div>
}

<!-- MODAL AGREGAR PROMOCIONES -->
<div class="modal fade"
     id="modalAgregarPromociones"
     tabindex="-1"
     role="dialog"
     aria-labelledby="tituloAgregarPromociones"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered"
         role="document">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="tituloAgregarPromociones">
                    Agregar promociones
                </h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="formAgregarPromociones">

                <div class="modal-body">

                    <!-- IMÁGENES -->
                    <div class="form-group">
                        <label for="archivosPromociones">
                            Seleccionar imágenes
                        </label>

                        <input type="file"
                               class="form-control-file"
                               id="archivosPromociones"
                               accept="image/jpeg,image/png,image/webp"
                               multiple
                               required>

                        <small class="form-text text-muted">
                            Puedes seleccionar varias imágenes.
                            Se subirán a Cloudinary.
                        </small>
                    </div>

                    <!-- VISTA PREVIA -->
                    <div id="previewPromociones"
                         style="display:grid;
                                grid-template-columns:
                                repeat(auto-fill,minmax(130px,1fr));
                                gap:12px;
                                margin-bottom:20px;">
                    </div>

                    <!-- FILA -->
                    <div class="form-group">
                        <label for="filaPromocion">
                            Fila del carrusel
                        </label>

                        <select id="filaPromocion"
                                class="form-control"
                                required>
                            <option value="1">
                                Fila 1 - Publicidad pequeña (4 cm)
                            </option>
                            <option value="2">
                                Fila 2 - Publicidad grande (10 cm)
                            </option>
                        </select>
                    </div>

                    <!-- ORDEN -->
                    <div class="form-group">
                        <label for="ordenPromocion">
                            Orden inicial
                        </label>

                        <input type="number"
                               id="ordenPromocion"
                               class="form-control"
                               min="1"
                               value="1"
                               required>

                        <small class="form-text text-muted">
                            Las imágenes seleccionadas ocuparán
                            posiciones consecutivas.
                        </small>
                    </div>

                    <!-- ENLACE -->
                    <div class="form-group">
                        <label for="enlacePromocion">
                            Enlace al hacer clic (opcional)
                        </label>

                        <input type="url"
                               id="enlacePromocion"
                               class="form-control"
                               maxlength="500"
                               placeholder="https://ejemplo.com">
                    </div>

                    <!-- ESTADO -->
                    <div class="form-group">
                        <label for="activoPromocion">
                            Estado
                        </label>

                        <select id="activoPromocion"
                                class="form-control">
                            <option value="true" selected>
                                Activo
                            </option>
                            <option value="false">
                                Inactivo
                            </option>
                        </select>
                    </div>

                    <div id="mensajePromociones"
                         role="status"
                         aria-live="polite"
                         style="display:none; margin-top:12px;">
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            id="btnGuardarPromociones"
                            class="btn btn-success">
                        Guardar promociones
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>




<!-- MODAL EDITAR PROMOCIÓN -->
<div class="modal fade"
     id="modalEditarPromocion"
     tabindex="-1"
     role="dialog"
     aria-labelledby="tituloEditarPromocion"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered"
         role="document">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="tituloEditarPromocion">
                    Editar promoción
                </h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="formEditarPromocion">
                <div class="modal-body">

                    <input type="hidden" id="editarIdProm">

                    <div class="form-group">
                        <label>Imagen actual</label>

                        <div>
                            <img id="editarVistaPrevia"
                                 src=""
                                 alt="Imagen promocional actual"
                                 style="max-width:100%; max-height:180px;
                                        object-fit:contain;">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="editarArchivoPromocion">
                            Reemplazar imagen (opcional)
                        </label>

                        <input type="file"
                               id="editarArchivoPromocion"
                               class="form-control-file"
                               accept="image/jpeg,image/png,image/webp">

                        <small class="form-text text-muted">
                            Si no seleccionas otra imagen, se conservará la actual.
                        </small>
                    </div>

                    <div class="form-group">
                        <label for="editarFilaPromocion">
                            Fila del carrusel
                        </label>

                        <select id="editarFilaPromocion"
                                class="form-control"
                                required>
                            <option value="1">Fila 1 - 4 cm</option>
                            <option value="2">Fila 2 - 10 cm</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="editarOrdenPromocion">
                            Orden de aparición
                        </label>

                        <input type="number"
                               id="editarOrdenPromocion"
                               class="form-control"
                               min="1"
                               required>
                    </div>

                    <div class="form-group">
                        <label for="editarEnlacePromocion">
                            Enlace de destino (opcional)
                        </label>

                        <input type="url"
                               id="editarEnlacePromocion"
                               class="form-control"
                               maxlength="500"
                               placeholder="https://ejemplo.com">
                    </div>

                    <div class="form-group">
                        <label for="editarActivoPromocion">
                            Estado
                        </label>

                        <select id="editarActivoPromocion"
                                class="form-control">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>

                    <div id="mensajeEditarPromocion"
                         role="status"
                         aria-live="polite"
                         style="display:none; padding:10px;">
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            id="btnGuardarEdicionPromocion"
                            class="btn btn-success">
                        Guardar cambios
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>


<!-- BOTÓN VER TODO -->
<div style="display:flex;
            justify-content:flex-end;
            padding:0 20px;
            margin-top:15px;
            margin-bottom:10px;">

    <a href="@Url.Action("Catalogo", "Catalogo")"
       class="btn btn-sm"
       style="background:#d7007c;
              color:white;
              font-weight:600;
              border-radius:6px;
              padding:7px 15px;">
        Ver todo →
    </a>

</div>

<!-- CARRUSEL PROMOCIONAL -->
<div id="carruselPromociones" class="promo-carousel">

    <!-- FILA 1: publicidad pequeña -->
    <div class="promo-fila promo-fila-1">
        <div id="pistaPromociones1" class="promo-pista"></div>
    </div>

    <!-- FILA 2: publicidad grande -->
    <div class="promo-fila promo-fila-2">
        <div id="pistaPromociones2" class="promo-pista"></div>
    </div>

</div>




<!-- CONTENEDOR GENERAL: FILTROS + PRODUCTOS -->
<div class="catalogo-layout">

    <!-- PANEL LATERAL DE FILTROS -->
    <aside class="panel-filtros" id="panelFiltros">

        <div class="filtros-header">
            <h4>Filtros</h4>
            <button type="button"
                    id="limpiarFiltros"
                    class="btn-limpiar-filtros">
                Limpiar
            </button>
        </div>

        <!-- ENTREGA -->
        <section class="filtro-seccion">

            <h5>Entrega</h5>

            <label class="filtro-opcion">
                <input type="checkbox" id="filtroNuevo">
                <span class="filtro-icono">
                    <!-- Icono de producto nuevo -->
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3l2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" />
                    </svg>
                </span>
                <span>Nuevo</span>
            </label>

            <label class="filtro-opcion">
                <input type="checkbox" id="filtroDomicilio">
                <span class="filtro-icono">
                    <!-- Icono de despacho -->
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 6h11v11H3z M14 10h4l3 4v3h-7z" />
                        <circle cx="7.5" cy="19" r="2" />
                        <circle cx="18" cy="19" r="2" />
                    </svg>
                </span>
                <span>Despacho a domicilio</span>
            </label>

            <label class="filtro-opcion">
                <input type="checkbox" id="filtroRetiro">
                <span class="filtro-icono">
                    <!-- Icono de punto de retiro -->
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0z" />
                        <circle cx="12" cy="10" r="2.5" />
                    </svg>
                </span>
                <span>Punto de retiro</span>
            </label>

        </section>

        <!-- MARCA -->
        <section class="filtro-seccion">

            <h5>Marca</h5>

            <div class="filtro-busqueda">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="10.5" cy="10.5" r="6.5" />
                    <path d="m16 16 5 5" />
                </svg>

                <input type="search"
                       id="filtroMarca"
                       placeholder="Buscar marca..."
                       autocomplete="off">
            </div>

        </section>

        <!-- PRECIO -->
        <section class="filtro-seccion">

            <h5>Precio</h5>

            <label class="filtro-opcion">
                <input type="checkbox" name="filtroPrecio"
                       value="menos10000">
                <span>Menos de S/ 10.000</span>
            </label>

            <label class="filtro-opcion">
                <input type="checkbox" name="filtroPrecio"
                       value="10000a20000">
                <span>S/ 10.000 - S/ 20.000</span>
            </label>

            <label class="filtro-opcion">
                <input type="checkbox" name="filtroPrecio"
                       value="mas20000">
                <span>Más de S/ 20.000</span>
            </label>

        </section>

        <button type="button"
                id="btnAplicarFiltros"
                class="btn-aplicar-filtros">
            Filtrar productos
        </button>

        <p id="mensajeFiltros"
           class="mensaje-filtros"
           aria-live="polite"></p>

    </aside>

    <!-- PRODUCTOS: SE CONSERVA EL ID QUE USA TU JAVASCRIPT -->
    <div class="products-container" id="contenedorProductos">

        <div id="loaderProductos" class="loader-productos">
            <div class="spinner-productos"></div>
            <span>Cargando productos...</span>
        </div>

    </div>

</div>

<div class="modal fade" id="modalZoom" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden;">

            <div class="modal-header border-0 pb-0" style="padding: 15px 20px;">
                <h5 class="modal-title" id="zoom-titulo-producto" style=" font-family: 'Montserrat', sans-serif;font-weight: 500; color: #464646; font-size: 1.15rem; max-width: 85%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    Detalle del Producto
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="font-size: 1.8rem; line-height: 1; padding: 10px 15px; margin: -10px -15px -10px auto;">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body" style="padding: 20px;">
                <div class="row">

                    <!-- CONTENEDOR DE IMAGEN PRINCIPAL CON FLECHAS -->
                    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center" style="border-right: 1px solid #f0f0f0;">
                        <div style="width: 100%; height: 380px; display: flex; align-items: center; justify-content: center; background: #ffffff; border-radius: 8px; overflow: hidden; border: 1px solid #eaeaea; position: relative;">

                            <!-- Flecha Izquierda -->
                            <button type="button" id="zoom-prev-btn" onclick="navegarImagenZoom(-1)" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.8); border: 1px solid #ddd; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 16px; color: #333; cursor: pointer; z-index: 10; transition: all 0.2s; box-shadow: 0 2px 5px rgba(0,0,0,0.1); outline: none;">
                                &#10094;
                            </button>

                            <img id="zoom-imagen-principal" src="" style="max-width: 100%; max-height: 100%; object-fit: contain;" />

                            <!-- Flecha Derecha -->
                            <button type="button" id="zoom-next-btn" onclick="navegarImagenZoom(1)" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.8); border: 1px solid #ddd; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 16px; color: #333; cursor: pointer; z-index: 10; transition: all 0.2s; box-shadow: 0 2px 5px rgba(0,0,0,0.1); outline: none;">
                                &#10095;
                            </button>

                        </div>

                        <div id="zoom-galeria-miniaturas" style="display: flex; gap: 8px; margin-top: 12px; width: 100%; justify-content: center; overflow-x: auto; padding-bottom: 5px;">
                        </div>
                    </div>

                    <!-- COLUMNA DE DETALLES (DERECHA) -->
                    <div class="col-md-6 d-flex flex-column justify-content-between" style="padding-left: 25px; min-height: 320px;">

                        <div style="line-height: 1.6;">
                            <span id="zoom-tipo-badge" style="background: #eef2f7; color: #0056b3; font-size: 11px; font-weight: bold; padding: 3px 8px; border-radius: 4px; text-transform: uppercase;">TIPO</span>

                            <h4 id="zoom-marca" style="font-weight: 800; margin-top: 8px; margin-bottom: 2px; color: #222;">MARCA</h4>
                            <p id="zoom-modelo-desc" style="color: #555; font-size: 14px; margin-bottom: 12px;">Modelo y descripción detallada del equipo.</p>

                            <!-- SECCIÓN CÓDIGO Y BOTÓN VERDE DEBAJO -->

                            <div style="margin-bottom: 15px;">
                                <div style="font-size: 13px; color: #777;">
                                    <span>Código de producto: </span><strong id="zoom-codigo" style="color: #333;">N/A</strong>
                                </div>

                                <!-- Enlace sutil estilo botón en color verde -->
                                
                                <a href="javascript:void(0)"
                                   id="zoom-btn-caracteristicas"
                                   style="font-size:12px; font-weight:bold; color:#d7007c; text-decoration:none;">
                                    ☷ Más características ▾
                                </a>
                                

                                <!-- SECCIÓN SELECCIÓN DE COLOR -->
                                <div id="zoom-color-container" style="margin-top: 12px;">
                                    <span style="font-size: 12px; font-weight: bold; color: #555; display: block; margin-bottom: 6px;">Color disponible:</span>
                                    <div id="zoom-lista-colores" style="display: flex; gap: 10px; align-items: center;">

                                        <!-- Ejemplo de Círculo de Color Activo/Seleccionado -->
                                        <button type="button" class="color-circle active"></button>
                                        <!-- Ejemplo de Círculo de Color Inactivo -->
                                        <button type="button" class="color-circle" style="width: 24px; height: 24px; border-radius: 50%; background-color: #ff0000; border: 1px solid #ccc; cursor: pointer; padding: 0; outline: none; transition: all 0.2s;"></button>

                                        <button type="button" class="color-circle" style="width: 24px; height: 24px; border-radius: 50%; background-color: #ffffff; border: 1px solid #ccc; cursor: pointer; padding: 0; outline: none; transition: all 0.2s;"></button>

                                    </div>
                                </div>
                            </div>

                            <!-- CONTENEDOR DE PRECIOS -->
                            <div style="background: #fbfbfb; padding: 12px; border-radius: 8px; border: 1px dashed #e5e5e5; margin-bottom: 20px; display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 10px;">

                                <!-- Lado Izquierdo: Precio Actual y Badge de Descuento -->
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <span id="zoom-precio-actual" style="font-size: 24px; font-weight: 800; color: #222; line-height: 1;">S/. 0.00</span>
                                    <span id="zoom-descuento-badge"
                                          style="
          background-color: #d7007c;
          color: white;
          font-size: 12px;
          font-weight: bold;
          padding: 4px 8px 4px 12px;
          clip-path: polygon(0 50%, 25% 0, 100% 0, 100% 100%, 25% 100%);
          display: none;
          line-height: 1.2;
          white-space: nowrap;
      ">
                                        -0%
                                    </span>
                                </div>

                                <!-- Lado Derecho: Precio Anterior -->
                                <div id="zoom-precio-antes-container" style="display: none; text-align: right;">
                                    <span style="color: #999; font-size: 13px; text-decoration: line-through;">Antes: </span>
                                    <span id="zoom-precio-antes" style="color: #999; font-size: 13px; text-decoration: line-through;">S/. 0.00</span>
                                </div>

                            </div>
                        </div>

                        <!-- SECCIÓN ACCIONES DE COMPRA -->
                        <div id="zoom-acciones-compra" style="border-top: 1px solid #f0f0f0; padding-top: 15px;">
                            <div style="display: flex; align-items: center; gap: 12px; width: 100%;">

                                <!-- Selector de Cantidad -->
                                <div style="display: inline-flex; align-items: center; border: 1px solid #ced4da; border-radius: 6px; overflow: hidden; background: #fff; height: 38px;">
                                    <button type="button" onclick="cambiarCantidadZoom(-1)" style="border: none; background: #f8f9fa; width: 32px; height: 100%; cursor: pointer; font-weight: bold; color: #333; padding: 0;">-</button>
                                    <span id="cant-display-zoom" style="min-width: 35px; text-align: center; font-weight: bold; font-size: 14px; color: #333; line-height: 38px;">1</span>
                                    <button type="button" onclick="cambiarCantidadZoom(1)" style="border: none; background: #f8f9fa; width: 32px; height: 100%; cursor: pointer; font-weight: bold; color: #333; padding: 0;">+</button>
                                </div>

                                <!-- Botón Agregar al Carrito -->
                                <button class="btn btn-primary btn-agregar-carrito" id="zoom-btn-agregar" style="flex: 1; height: 38px; font-weight: bold; display: inline-flex; align-items: center; justify-content: center; margin: 0;">
                                    Agregar al carrito
                                </button>

                            </div>
                        </div>

                        <!-- BLOQUES INFORMATIVOS -->
                        <div style="display: flex; gap: 10px; justify-content: space-between; margin-top: 22px; width: 100%; flex-wrap: nowrap;">
                            <!-- Recuadro 1: Garantía -->
                            <div id="zoom-garantia-container"  style="flex: 1; background: #fff; padding: 10px 4px; border-radius: 8px; border: 1px solid #eaeaea; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; aspect-ratio: 1.2 / 1;">
                                <span style="font-size: 16px; margin-bottom: 2px;">🛡️</span>
                                <strong style="font-size: 10px; color: #333; display: block; line-height: 1;">Garantía</strong>
                                <span id="zoom-garantia"  style="font-size: 9px; color: #777; line-height: 1; margin-top: 1px;">12 Meses</span>
                            </div>
                            <!-- Recuadro 2: Formas de Pago -->
                            <div style="flex: 1; background: #fff; padding: 10px 4px; border-radius: 8px; border: 1px solid #eaeaea; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; aspect-ratio: 1.2 / 1;">
                                <span style="font-size: 16px; margin-bottom: 2px;">💳</span>
                                <strong style="font-size: 10px; color: #333; display: block; line-height: 1;">Pagos</strong>
                                <span style="font-size: 9px; color: #777; line-height: 1; margin-top: 1px;">Efectivo/Tarj.</span>
                            </div>
                            <!-- Recuadro 3: Envíos -->
                            <div style="flex: 1; background: #fff; padding: 10px 4px; border-radius: 8px; border: 1px solid #eaeaea; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; aspect-ratio: 1.2 / 1;">
                                <span style="font-size: 16px; margin-bottom: 2px;">🚚</span>
                                <strong style="font-size: 10px; color: #333; display: block; line-height: 1;">Envíos</strong>
                                <span style="font-size: 9px; color: #777; line-height: 1; margin-top: 1px;">Todo el Perú</span>
                            </div>
                        </div>

                    </div> <!-- FIN DE COLUMNA DE DETALLES -->
                </div> <!-- FIN DEL ROW ORIGINAL -->
                <!-- RECUADRO DESPLEGABLE ABAJO DEL TODO (Ideal para mucha información) -->
                <div class="collapse" id="zoom-caracteristicas-collapse" style="width: 100%; margin-top: 25px; border-top: 1px dashed #e5e5e5; padding-top: 20px;">
                    <div style="background: #fdfdfd; border: 1px solid #eaeaea; border-radius: 10px; padding: 16px; font-size: 13px; color: #444; line-height: 1.6; box-shadow: inset 0 1px 3px rgba(0,0,0,0.02);">
                        <strong style="font-family: 'Montserrat', sans-serif; color: #777777; font-weight: 450 !important; display: block; margin-bottom: 8px; font-size: 14px;">INFORMACIÓN DE ESTE PRODUCTO</strong>
                        <div id="zoom-caracteristicas-titulo"
                             style="
font-family: 'Montserrat', sans-serif;

@model Proyecto1.Views.Inicio.IndexModel
@{
    ViewData["Title"] = "Inicio";

    var estaLogueado = User.Identity.IsAuthenticated;

    Layout = estaLogueado
        ? "~/Views/Shared/_LayoutNavegador.cshtml"
        : "~/Views/Shared/_LayoutInicio.cshtml";
}

<div id="configVistaIndex" data-vista="Index" hidden></div>

<head>


    <link rel="stylesheet" href="~/css/carrusel.css" />


</head>


@if (User.Identity?.IsAuthenticated == true)
{
    <div style="display:flex; justify-content:flex-start;
                    padding:0 20px; margin:10px 0;">

        <button type="button"
                class="btn btn-success"
                data-toggle="modal"
                data-target="#modalAgregarPromociones">
            <i class="feather icon-image"></i>
            Agregar promociones
        </button>

    </div>
}


@if (User.Identity?.IsAuthenticated == true)
{
    <div style="padding: 10px 20px;">
        <button type="button"
                class="btn btn-primary"
                onclick="cargarListaPromociones()">
            <i class="feather icon-edit"></i>
            Administrar promociones
        </button>
    </div>

    <div id="listaAdministrarPromociones"
         style="display:none; padding:20px;">

        <h5>Promociones registradas</h5>

        <div id="tablaPromociones"></div>
    </div>
}

<!-- MODAL AGREGAR PROMOCIONES -->
<div class="modal fade"
     id="modalAgregarPromociones"
     tabindex="-1"
     role="dialog"
     aria-labelledby="tituloAgregarPromociones"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered"
         role="document">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="tituloAgregarPromociones">
                    Agregar promociones
                </h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="formAgregarPromociones">

                <div class="modal-body">

                    <!-- IMÁGENES -->
                    <div class="form-group">
                        <label for="archivosPromociones">
                            Seleccionar imágenes
                        </label>

                        <input type="file"
                               class="form-control-file"
                               id="archivosPromociones"
                               accept="image/jpeg,image/png,image/webp"
                               multiple
                               required>

                        <small class="form-text text-muted">
                            Seleccione fotografías que tengan 1920 px x 38 px para fila 1 y 1920 px x 600 px para fila 2 
                        </small>
                    </div>

                    <!-- VISTA PREVIA -->
                    <div id="previewPromociones"
                         style="display:grid;
                                grid-template-columns:
                                repeat(auto-fill,minmax(130px,1fr));
                                gap:12px;
                                margin-bottom:20px;">
                    </div>

                    <!-- FILA -->
                    <div class="form-group">
                        <label for="filaPromocion">
                            Fila del carrusel
                        </label>

                        <select id="filaPromocion"
                                class="form-control"
                                required>
                            <option value="1">
                                Fila 1 - Publicidad pequeña (4 cm)
                            </option>
                            <option value="2">
                                Fila 2 - Publicidad grande (10 cm)
                            </option>
                        </select>
                    </div>

                    <!-- ORDEN -->
                    <div class="form-group">
                        <label for="ordenPromocion">
                            Orden inicial
                        </label>

                        <input type="number"
                               id="ordenPromocion"
                               class="form-control"
                               min="1"
                               value="1"
                               required>

                        <small class="form-text text-muted">
                            Las imágenes seleccionadas ocuparán
                            posiciones consecutivas.
                        </small>
                    </div>

                    <!-- ENLACE -->
                    <div class="form-group">
                        <label for="enlacePromocion">
                            Enlace al hacer clic (opcional)
                        </label>

                        <input type="url"
                               id="enlacePromocion"
                               class="form-control"
                               maxlength="500"
                               placeholder="https://ejemplo.com">
                    </div>

                    <!-- ESTADO -->
                    <div class="form-group">
                        <label for="activoPromocion">
                            Estado
                        </label>

                        <select id="activoPromocion"
                                class="form-control">
                            <option value="true" selected>
                                Activo
                            </option>
                            <option value="false">
                                Inactivo
                            </option>
                        </select>
                    </div>

                    <div id="mensajePromociones"
                         role="status"
                         aria-live="polite"
                         style="display:none; margin-top:12px;">
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            id="btnGuardarPromociones"
                            class="btn btn-success">
                        Guardar promociones
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>




<!-- MODAL EDITAR PROMOCIÓN -->
<div class="modal fade"
     id="modalEditarPromocion"
     tabindex="-1"
     role="dialog"
     aria-labelledby="tituloEditarPromocion"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered"
         role="document">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="tituloEditarPromocion">
                    Editar promoción
                </h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="formEditarPromocion">
                <div class="modal-body">

                    <input type="hidden" id="editarIdProm">

                    <div class="form-group">
                        <label>Imagen actual</label>

                        <div>
                            <img id="editarVistaPrevia"
                                 src=""
                                 alt="Imagen promocional actual"
                                 style="max-width:100%; max-height:180px;
                                        object-fit:contain;">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="editarArchivoPromocion">
                            Reemplazar imagen (opcional)
                        </label>

                        <input type="file"
                               id="editarArchivoPromocion"
                               class="form-control-file"
                               accept="image/jpeg,image/png,image/webp">

                        <small class="form-text text-muted">
                            Si no seleccionas otra imagen, se conservará la actual.
                        </small>
                    </div>

                    <div class="form-group">
                        <label for="editarFilaPromocion">
                            Fila del carrusel
                        </label>

                        <select id="editarFilaPromocion"
                                class="form-control"
                                required>
                            <option value="1">Fila 1 - 4 cm</option>
                            <option value="2">Fila 2 - 10 cm</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="editarOrdenPromocion">
                            Orden de aparición
                        </label>

                        <input type="number"
                               id="editarOrdenPromocion"
                               class="form-control"
                               min="1"
                               required>
                    </div>

                    <div class="form-group">
                        <label for="editarEnlacePromocion">
                            Enlace de destino (opcional)
                        </label>

                        <input type="url"
                               id="editarEnlacePromocion"
                               class="form-control"
                               maxlength="500"
                               placeholder="https://ejemplo.com">
                    </div>

                    <div class="form-group">
                        <label for="editarActivoPromocion">
                            Estado
                        </label>

                        <select id="editarActivoPromocion"
                                class="form-control">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>

                    <div id="mensajeEditarPromocion"
                         role="status"
                         aria-live="polite"
                         style="display:none; padding:10px;">
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            id="btnGuardarEdicionPromocion"
                            class="btn btn-success">
                        Guardar cambios
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>


<nav id="breadcrumbCategorias"
     class="breadcrumb-categorias"
     aria-label="Ruta de navegación">
</nav>

<!-- CARRUSEL PROMOCIONAL -->
<div id="carruselPromociones" class="promo-carousel">

    <!-- FILA 1: publicidad pequeña -->
    <!-- FILA 1: PUBLICIDAD PEQUEÑA -->
    <div class="promo-fila promo-fila-1">

        <!-- CONTENEDOR DE LA IMAGEN -->
        <div class="promo-fila-1-visor">
            <div id="pistaPromociones1" class="promo-pista"></div>
        </div>

        <!-- BOTÓN VER TODO -->
        <a href="@Url.Action("Catalogo", "Catalogo")"
           class="btn-ver-todo">
            <span>Ver todo</span>
            <span class="btn-ver-todo-flecha" aria-hidden="true"></span>
        </a>

    </div>

    <!-- FILA 2: PUBLICIDAD GRANDE -->
    <div class="promo-fila promo-fila-2">

        <!-- VISOR DE IMÁGENES -->
        <div class="promo-fila-2-visor">

            <div id="pistaPromociones2" class="promo-pista"></div>

            <!-- FLECHA ANTERIOR -->
            <button type="button"
                    class="promo-flecha promo-flecha-anterior"
                    aria-label="Imagen anterior">
                <span></span>
            </button>

            <!-- FLECHA SIGUIENTE -->
            <button type="button"
                    class="promo-flecha promo-flecha-siguiente"
                    aria-label="Imagen siguiente">
                <span></span>
            </button>

        </div>

        <!-- INDICADORES -->
        <div id="indicadoresPromociones2"
             class="promo-indicadores">
        </div>

    </div>


    <!-- FILA 3: SUBCATEGORÍAS CIRCULARES -->
    <div id="subcategoriasCirculares" class="subcategorias-circulares">

        <button type="button"
                class="subcategorias-flecha subcategorias-flecha-anterior"
                aria-label="Subcategorías anteriores">
            &#10094;
        </button>

        <div class="subcategorias-circulares-visor">
            <div id="pistaSubcategoriasCirculares"
                 class="subcategorias-circulares-pista">
            </div>
        </div>

        <button type="button"
                class="subcategorias-flecha subcategorias-flecha-siguiente"
                aria-label="Más subcategorías">
            &#10095;
        </button>

    </div>

</div>




<!-- CONTENEDOR GENERAL: FILTROS + PRODUCTOS -->
<div class="catalogo-layout">

    @if (!estaLogueado)

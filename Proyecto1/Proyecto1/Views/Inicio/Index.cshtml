<div class="modal fade" id="modalZoom" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="zoom-titulo-producto">
                    Detalle del Producto
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">

                    <!-- COLUMNA IZQUIERDA: IMAGEN Y MINIATURAS -->
                    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center zoom-stage-col">
                        <div class="zoom-main-frame">
                            <button type="button" id="zoom-prev-btn" class="zoom-nav-btn zoom-nav-prev" onclick="navegarImagenZoom(-1)" aria-label="Imagen anterior">
                                <span class="zoom-chevron" aria-hidden="true"></span>
                            </button>

                            <img id="zoom-imagen-principal" src="" alt="Vista previa del producto" />

                            <button type="button" id="zoom-next-btn" class="zoom-nav-btn zoom-nav-next" onclick="navegarImagenZoom(1)" aria-label="Siguiente imagen">
                                <span class="zoom-chevron" aria-hidden="true"></span>
                            </button>
                        </div>

                        <div id="zoom-galeria-miniaturas"></div>
                    </div>

                    <!-- COLUMNA DERECHA: DETALLES Y COMPRA -->
                    <div class="col-md-6 d-flex flex-column justify-content-between zoom-details-col">
                        <div>
                            <span id="zoom-tipo-badge" class="zoom-type-badge">TIPO</span>

                            <h4 id="zoom-marca">MARCA</h4>
                            <p id="zoom-modelo-desc">Modelo y descripción detallada del equipo.</p>

                            <div class="zoom-code-row">
                                <span>Código de producto: </span>
                                <strong id="zoom-codigo">N/A</strong>
                            </div>

                            <a href="javascript:void(0)"
                               id="zoom-btn-caracteristicas"
                               class="zoom-specs-link">
                                <span>&#9783; Más características</span>
                                <span aria-hidden="true">&#9662;</span>
                            </a>

                            <div id="zoom-color-container" class="zoom-color-section">
                                <span class="zoom-section-label">Color disponible</span>
                                <div id="zoom-lista-colores">
                                    <button type="button" class="color-circle active" style="background-color: #7A1F87;" aria-label="Color principal"></button>
                                    <button type="button" class="color-circle" style="background-color: #DC2626;" aria-label="Rojo"></button>
                                    <button type="button" class="color-circle" style="background-color: #FFFFFF;" aria-label="Blanco"></button>
                                </div>
                            </div>

                            <div id="zoom-precios-container" class="zoom-price-box">
                                <div class="zoom-price-main">
                                    <span id="zoom-precio-actual"></span>
                                    <span id="zoom-descuento-badge" style="display: none;">-0%</span>
                                </div>

                                <div id="zoom-precio-antes-container" style="display: none;">
                                    <span>Antes: </span>
                                    <span id="zoom-precio-antes"></span>
                                </div>
                            </div>
                        </div>

                        <div>
                            <div id="zoom-acciones-compra" class="zoom-purchase-bar">
                                <div class="zoom-qty-control">
                                    <button type="button" class="zoom-qty-btn" onclick="cambiarCantidadZoom(-1)" aria-label="Disminuir cantidad">-</button>
                                    <span id="cant-display-zoom">1</span>
                                    <button type="button" class="zoom-qty-btn" onclick="cambiarCantidadZoom(1)" aria-label="Aumentar cantidad">+</button>
                                </div>

                                <button type="button" class="btn btn-agregar-carrito" id="zoom-btn-agregar">
                                    Agregar al carrito
                                </button>
                            </div>

                            <div class="zoom-perks-grid">
                                <div id="zoom-garantia-container" class="zoom-perk-card">
                                    <span class="zoom-perk-icon" aria-hidden="true">🛡️</span>
                                    <strong class="zoom-perk-title">Garantía</strong>
                                    <span id="zoom-garantia" class="zoom-perk-sub">12 Meses</span>
                                </div>
                                <div class="zoom-perk-card">
                                    <span class="zoom-perk-icon" aria-hidden="true">💳</span>
                                    <strong class="zoom-perk-title">Pagos</strong>
                                    <span class="zoom-perk-sub">Efectivo / Tarjeta</span>
                                </div>
                                <div class="zoom-perk-card">
                                    <span class="zoom-perk-icon" aria-hidden="true">🚚</span>
                                    <strong class="zoom-perk-title">Envíos</strong>
                                    <span class="zoom-perk-sub">Todo el Perú</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ESPECIFICACIONES DESPLEGABLES -->
                <div class="collapse zoom-specs-panel" id="zoom-caracteristicas-collapse">
                    <div class="zoom-specs-box">
                        <strong class="zoom-specs-eyebrow">Información de este producto</strong>
                        <div id="zoom-caracteristicas-titulo"></div>
                        <div id="zoom-caracteristicas-texto">Cargando especificaciones adicionales...</div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


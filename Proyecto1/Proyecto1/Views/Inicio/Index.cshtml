                    </div>

                    <!-- Preview -->
                    <div id="editar_previewContainer"
                         style="display:flex; gap:10px; flex-wrap:wrap; margin-top:10px;">
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            id="btnActualizar"
                            class="btn btn-primary w-100">
                        Guardar cambios
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

<div class="modal fade" id="modalZoom" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Imagen</h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body text-center position-relative"
                 style="height:600px; display:flex; align-items:center; justify-content:center;">

                <button id="btnPrev"
                        onclick="prevImage()"
                        style="position:absolute;left:10px;top:50%;transform:translateY(-50%);
                   background:none;border:none;font-size:30px;z-index:10;">
                    ◀
                </button>

                <img id="imgZoom"
                     style="max-width:100%; max-height:100%; object-fit:contain;" />

                <button id="btnNext"
                        onclick="nextImage()"
                        style="position:absolute;right:10px;top:50%;transform:translateY(-50%);
                   background:none;border:none;font-size:30px;z-index:10;">
                    ▶
                </button>

            </div>

        </div>
    </div>

</div>

<div id="toastMensaje"
     style="
        position: fixed;
        top: 20px;
        right: 20px;
        background: #28a745;
        color: white;
        padding: 12px 18px;
        border-radius: 6px;
        display: none;
        z-index: 9999;
        font-weight: 500;
     ">
    Guardado correctamente
</div>



<script>
    const estaLogueado = @User.Identity.IsAuthenticated.ToString().ToLower();
</script>

<script src="~/js/InicioMuestra.js"></script>
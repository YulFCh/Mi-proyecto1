<div class="modal fade" id="modalCheckout" tabindex="-1" role="dialog" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">

        <div class="modal-content checkout-modal-content">

            <!-- ========================================= -->
            <!-- HEADER -->
            <!-- ========================================= -->


            <div class="modal-header border-0 checkout-header">

                <div class="checkout-header-content">


                    <div class="checkout-header-icon">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="21"
                             height="21"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="M3 6h12v12H3z" />
                            <path d="M15 10h4l3 4v4h-7z" />
                            <circle cx="7.5" cy="18" r="2" />
                            <circle cx="18.5" cy="18" r="2" />
                            <path d="M15 14h7" />
                        </svg>
                    </div>

                    <div class="checkout-header-text">
                        <h5 class="modal-title">
                            Datos de Envío y Facturación
                        </h5>

                        <p>Completa tus datos para coordinar la entrega</p>
                    </div>

                </div>

                <button type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Cerrar">

                    <span>&times;</span>

                </button>

            </div>


            <!-- ========================================= -->
            <!-- FORMULARIO -->
            <!-- ========================================= -->

            <form id="formCheckout"
                  onsubmit="procesarCompra(event)"
                  class="checkout-form">

                <!-- ===================================== -->
                <!-- CONTENIDO -->
                <!-- ===================================== -->

                <div class="modal-body checkout-body">


                    <!-- ================================ -->
                    <!-- DATOS PERSONALES -->
                    <!-- ================================ -->

                    <div class="row">

                        <div class="form-group col-md-6">

                            <label style="font-weight: 600; font-size: 13px;">
                                Nombres
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="chkNombres"
                                   class="form-control"
                                   required
                                   style="border-radius: 6px;">

                        </div>


                        <div class="form-group col-md-6">

                            <label style="font-weight: 600; font-size: 13px;">
                                Apellidos
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="chkApellidos"
                                   class="form-control"
                                   required
                                   style="border-radius: 6px;">

                        </div>

                    </div>


                    <!-- ================================ -->
                    <!-- DNI / CELULAR -->
                    <!-- ================================ -->

                    <div class="row">

                        <div class="form-group col-md-6">

                            <label style="font-weight: 600; font-size: 13px;">
                                DNI
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="chkDni"
                                   class="form-control"
                                   required
                                   maxlength="12"
                                   style="border-radius: 6px;">

                        </div>


                        <div class="form-group col-md-6">

                            <label style="font-weight: 600; font-size: 13px;">
                                Número de Celular
                                <span class="text-danger">*</span>
                            </label>

                            <input type="tel"
                                   id="chkCelular"
                                   class="form-control"
                                   required
                                   style="border-radius: 6px;">

                        </div>

                    </div>


                    <!-- ================================ -->
                    <!-- CORREO -->
                    <!-- ================================ -->

                    <div class="row">

                        <div class="form-group col-12">

                            <label style="font-weight: 600; font-size: 13px;">
                                Correo Electrónico
                                <span class="text-danger">*</span>
                            </label>

                            <input type="email"
                                   id="chkCorreo"
                                   class="form-control"
                                   required
                                   style="border-radius: 6px;">

                        </div>

                    </div>


                    <hr style="border-style: dashed; margin: 15px 0;">


                    <!-- ================================ -->
                    <!-- DIRECCIÓN -->
                    <!-- ================================ -->

                    <h6 style="
                        font-weight: bold;
                        margin-bottom: 15px;
                        font-size: 14px;
                        color: #555;
                    ">
                        Dirección de Entrega
                    </h6>


                    <div class="row">

                        <!-- REGIÓN -->

                        <div class="form-group col-md-4">

                            <label style="font-weight: 600; font-size: 13px;">
                                Región
                                <span class="text-danger">*</span>
                            </label>

                            <select id="chkRegion"
                                    class="form-control"
                                    required
                                    style="border-radius: 6px;">

                                <option value="">
                                    Seleccione...
                                </option>

                            </select>

                        </div>


                        <!-- PROVINCIA -->

                        <div class="form-group col-md-4">

                            <label style="font-weight: 600; font-size: 13px;">
                                Provincia
                                <span class="text-danger">*</span>
                            </label>

                            <select id="chkProvincia"
                                    class="form-control"
                                    required
                                    disabled
                                    style="border-radius: 6px;">

                                <option value="">
                                    Seleccione...
                                </option>

                            </select>

                        </div>


                        <!-- DISTRITO -->

                        <div class="form-group col-md-4">

                            <label style="font-weight: 600; font-size: 13px;">
                                Distrito
                                <span class="text-danger">*</span>
                            </label>

                            <select id="chkDistrito"
                                    class="form-control"
                                    required
                                    disabled
                                    style="border-radius: 6px;">

                                <option value="">
                                    Seleccione...
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- ================================ -->
                    <!-- DIRECCIÓN -->
                    <!-- ================================ -->

                    <div class="row">

                        <div class="form-group col-12">

                            <label style="font-weight: 600; font-size: 13px;">
                                Dirección de Domicilio
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="chkDireccion"
                                   class="form-control"
                                   placeholder="Av. Principal 123 - Dpto 401"
                                   required
                                   style="border-radius: 6px;">

                        </div>

                    </div>

                    <!-- ================================ -->
                    <!-- NOTA DEL CLIENTE -->
                    <!-- ================================ -->

                    <div class="row">

                        <div class="form-group col-12">

                            <label style="font-weight: 600; font-size: 13px;">
                                Nota del cliente
                                <span class="text-muted">(Opcional)</span>
                            </label>

                            <textarea id="chkNotaCliente"
                                      class="form-control"
                                      rows="2"
                                      maxlength="500"                                     
                                      style="border-radius: 6px; resize: vertical;"></textarea>

                        </div>

                    </div>
             



                    <!-- ================================ -->
                    <!-- TOTAL -->
                    <!-- ================================ -->

                    <div class="checkout-total">

                        <span>
                            Monto Final a Pagar:
                        </span>

                        <strong id="chkMontoFinal">
                            S/. 0.00
                        </strong>

                    </div>

                </div>


                <!-- ===================================== -->
                <!-- FOOTER -->
                <!-- ===================================== -->

                <div class="modal-footer border-0 checkout-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal"
                            style="border-radius: 6px;">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn btn-success"
                            style="
                                border-radius: 6px;
                                font-weight: bold;
                                padding-left: 25px;
                                padding-right: 25px;
                            ">

                        Finalizar Pedido

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


